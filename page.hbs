{{!< default}}
{{#post}}
<article class="page-content">
  {{#if @page.show_title_and_feature_image}}
  <header class="archive-header page-header"><h1>{{title}}</h1></header>
  {{#if feature_image}}<figure class="feature"><img src="{{img_url feature_image size="xl"}}" alt="{{feature_image_alt}}"></figure>{{/if}}
  {{/if}}
  <div class="gh-content page-body">{{content}}</div>
</article>
{{/post}}
