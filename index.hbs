{{!< default}}
<section class="publication-hero{{#match @custom.show_editor_selection false}} publication-hero--intro-only{{/match}}"><div class="publication-intro"><p class="eyebrow">Independent research & analysis</p><h1>{{#if @custom.hero_title}}{{@custom.hero_title}}{{else}}{{@site.title}}{{/if}}</h1><p class="lead">{{#if @custom.hero_description}}{{@custom.hero_description}}{{else}}{{@site.description}}{{/if}}</p><div class="hero-actions"><a class="text-link" href="#research-library">Explore the latest research <span aria-hidden="true">↓</span></a>
{{#if @member}}<a class="button" href="#/portal/account">Your account</a>
{{else}}
  {{#if @site.allow_self_signup}}
    {{#match @site.members_signup_access "all"}}<a class="button" href="#/portal/signup">{{#if @custom.hero_signup_label}}{{@custom.hero_signup_label}}{{else}}Get research updates{{/if}}</a>
    {{else}}
      {{#if @site.paid_members_enabled}}<a class="button" href="#/portal/signup">View plans</a>
      {{else}}<a class="button" href="#/portal/signin">Sign in</a>{{/if}}
    {{/match}}
  {{else}}<a class="button" href="#/portal/signin">Sign in</a>{{/if}}
{{/if}}
</div></div>{{#match @custom.show_editor_selection false}}{{else}}<div class="editorial-selection">{{#get "posts" filter="featured:true" order="published_at desc" limit="1" include="tags,authors"}}
{{#foreach posts}}<article class="spotlight"><p class="eyebrow">Editor's selection</p><div class="card-meta">{{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}}{{> "access-badge"}}</div><h2><a href="{{url}}">{{title}}</a></h2>{{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}<p class="card-footer"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time></p></article>
{{else}}<aside class="reading-guide"><p class="eyebrow">The research desk</p><h2>Make room for a closer look.</h2><p>Read the full argument, follow its sources and return to the topics that matter to you.</p><a href="#research-library">Browse the latest publications</a></aside>{{/foreach}}{{/get}}</div>{{/match}}</section>
<section id="research-library" class="section" tabindex="-1"><header class="section-heading"><div><p class="eyebrow">From the research desk</p><h2>Latest research</h2></div><p>Reports and briefings · Newest first</p></header><div class="library-layout">{{> "library-nav" in_section=true}}<div class="library-results"><div class="cards">{{#foreach posts}}{{> "card" in_section=true}}{{else}}<p class="empty-state">Research is coming soon.</p>{{/foreach}}</div>{{pagination}}</div></div></section>
