{{!< default}}
<section class="hero"><p class="eyebrow">Independent research & analysis</p><h1>{{@site.title}}</h1><p>{{@site.description}}</p>
{{#if @member}}<a class="button" href="#/portal/account">Your account</a>
{{else}}
  {{#if @site.allow_self_signup}}
    {{#match @site.members_signup_access "all"}}<a class="button" href="#/portal/signup">Get research updates</a>
    {{else}}
      {{#if @site.paid_members_enabled}}<a class="button" href="#/portal/signup">View plans</a>
      {{else}}<a class="button" href="#/portal/signin">Sign in</a>{{/if}}
    {{/match}}
  {{else}}<a class="button" href="#/portal/signin">Sign in</a>{{/if}}
{{/if}}
</section>
<section class="section"><h2>Latest research</h2><div class="cards">{{#foreach posts}}{{> "card"}}{{else}}<p>Research is coming soon.</p>{{/foreach}}</div>{{pagination}}</section>
