<article class="card"><div class="card-meta">{{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}} · <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time></div><h3><a href="{{url}}">{{title}}</a></h3>{{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{else}}{{#if excerpt}}<p>{{excerpt words="28"}}</p>{{/if}}{{/if}}<span class="reading-time">{{reading_time}}</span></article>
