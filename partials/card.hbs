<article class="card"><div class="card-meta">{{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}}{{> "access-badge"}}</div>{{#if in_section}}<h3><a href="{{url}}">{{title}}</a></h3>{{else}}<h2><a href="{{url}}">{{title}}</a></h2>{{/if}}{{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{else}}{{#if excerpt}}<p>{{excerpt words="28"}}</p>{{/if}}{{/if}}<div class="card-footer"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>{{#if access}}<span class="reading-time">{{reading_time}}</span>{{/if}}</div>{{#if authors}}<p class="card-byline">By {{authors}}</p>{{/if}}</article>
