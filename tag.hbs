{{!< default}}{{#tag}}<header class="archive-header"><p class="eyebrow">Research collection</p><h1>{{name}}</h1>{{#if description}}<p>{{description}}</p>{{/if}}</header>{{/tag}}<div class="library-layout">{{> "library-nav"}}<section class="library-results" aria-label="Publications"><div class="cards">{{#foreach posts}}{{> "card"}}{{else}}<p class="empty-state">No publications in this collection yet.</p>{{/foreach}}</div>{{pagination}}</section></div>
