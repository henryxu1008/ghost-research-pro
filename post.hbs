{{!< default}}
{{#post}}<article class="report"><header class="report-header"><p class="eyebrow">{{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}}</p><h1>{{title}}</h1>{{#if custom_excerpt}}<p class="lead">{{custom_excerpt}}</p>{{/if}}<p class="byline">By {{authors}} · <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>{{#if access}} · {{reading_time}}{{/if}}</p></header>{{#if feature_image}}<figure class="feature"><img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"></figure>{{/if}}<div class="gh-content">{{content}}</div>{{#if access}}{{#if @member}}<p class="member-note">Thanks for being a member.</p>{{else}}<aside class="subscribe"><h2>Stay informed</h2><p>Subscribe for more research and analysis.</p><a class="button" href="#/portal/signup">Subscribe</a></aside>{{/if}}{{/if}}</article>{{/post}}
