{{!< default}}
{{#post}}<article class="report"><header class="report-header"><p class="eyebrow">{{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}}</p><h1>{{title}}</h1>{{#if custom_excerpt}}<p class="lead">{{custom_excerpt}}</p>{{/if}}<p class="byline">By {{authors}} · <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>{{#if access}} · {{reading_time}}{{/if}}</p></header>{{#if feature_image}}<figure class="feature"><img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"></figure>{{/if}}<nav class="report-toc" aria-label="Table of contents" hidden><p class="report-toc-title">On this page</p><ol></ol></nav><div class="gh-content">{{content}}</div>{{#if access}}{{#if @member}}<p class="member-note">Thanks for being a member.</p>{{else}}<aside class="subscribe"><h2>Stay informed</h2>
{{#if @site.allow_self_signup}}
  {{#match @site.members_signup_access "all"}}
  <p>Subscribe for more research and analysis.</p><a class="button" href="#/portal/signup">Subscribe</a>
  {{else}}
    {{#if @site.paid_members_enabled}}
    <p>Explore paid membership options.</p><a class="button" href="#/portal/signup">View plans</a>
    {{else}}
    <p>New memberships are currently unavailable.</p><a class="button" href="#/portal/signin">Sign in</a>
    {{/if}}
  {{/match}}
{{else}}
<p>Sign in to your existing membership.</p><a class="button" href="#/portal/signin">Sign in</a>
{{/if}}
</aside>{{/if}}{{/if}}</article>{{/post}}
