{{!< default}}
{{#post}}
{{#if @page.show_title_and_feature_image}}
<section class="hero"><p class="eyebrow">Membership</p><h1>{{title}}</h1>{{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}</section>
{{/if}}
<div class="gh-content">{{content}}</div>
{{/post}}
<section class="membership-grid" aria-label="Membership options">
  <article class="membership-plan"><h2>Free updates</h2><p>Receive publicly available research and announcements.</p><a class="button" href="#/portal/signup">Join for free</a></article>
  {{#if @site.paid_members_enabled}}
  <article class="membership-plan"><h2>Premium research</h2><p>Access paid reports and subscriber-only research, subject to the publication's subscription settings.</p><a class="button" href="#/portal/signup">View plans</a></article>
  {{/if}}
</section>
