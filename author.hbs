{{!< default}}{{#author}}<header class="archive-header author-header">{{#if profile_image}}<img class="author-image" src="{{img_url profile_image size="s"}}" alt="">{{/if}}<div><p class="eyebrow">Research analyst</p><h1>{{name}}</h1>{{#if bio}}<p>{{bio}}</p>{{/if}}</div></header>{{/author}}<header class="section-heading"><p class="eyebrow">Publications</p><p>Newest first</p></header><div class="cards">{{#foreach posts}}{{> "card"}}{{else}}<p class="empty-state">No publications by this author yet.</p>{{/foreach}}</div>{{pagination}}
